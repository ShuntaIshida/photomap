# コピーして frontend/.env.local を作成する（.env.local は Git に含めない）。
VITE_BASE_PATH=/
# Cloud Run APIのベースURL（末尾スラッシュなし）。地域一覧・写真アップロード・サムネイルに使う。
# 未設定・空の場合はデプロイ済みのCloud Run（https://photomap-api-506452568070.asia-northeast1.run.app）を使う。ローカルAPIを使うときだけ設定する。
# VITE_API_BASE_URL=http://localhost:8080
VITE_GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_MAPS_MAP_ID=

# Firebase コンソール > プロジェクトの設定 > マイアプリ（Web）の設定値
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=photomap-app1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=photomap-app1
VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
