{
  "name": "photomap-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^7.2.0",
    "@googleapis/drive": "^27.0.0",
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "exifr": "^7.1.3",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.2",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
