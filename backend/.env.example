# ローカル開発用。コピーして backend/.env を作成する（Gitに含めない）。
# Cloud Runでは値をSecret Manager / 環境変数で渡す（README参照）。実際の値はここに書かない。

PORT=8080
FIREBASE_PROJECT_ID=photomap-app1

# OAuth 2.0 Webクライアント "Photomap Drive Backend"
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# ローカル: http://localhost:8080/oauth/google/callback / 本番: https://<Cloud RunのURL>/oauth/google/callback
OAUTH_REDIRECT_URI=http://localhost:8080/oauth/google/callback

DRIVE_PARENT_FOLDER_ID=17pp81R43EeQOIpaOtNR0IAIRldykz-Fq
# Drive所有者（認可を行う大学アカウント）。別アカウントでの認可は拒否される。
DRIVE_OWNER_EMAIL=
# リフレッシュトークンを保存するSecret Managerのシークレット名
DRIVE_REFRESH_TOKEN_SECRET=photomap-drive-refresh-token

# 管理者UID（カンマ区切り）。カスタムクレーム admin=true でも管理者になる。
ADMIN_UIDS=
# 空の場合は https://shuntaishida.github.io と localhost:5173 / 127.0.0.1:5173
CORS_ALLOWED_ORIGINS=
